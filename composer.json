    "wexample/symfony-ai": ">=6.0.0",
    "wexample/symfony-api": ">=17.0.0",
    "wexample/symfony-conversation": ">=5.0.0",
    "wexample/symfony-design-system": ">=44.0.0",
    "wexample/symfony-forms": ">=16.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-live": ">=5.8.0",
