{
  "name": "wexample/symfony-ai-conversation",
  "version": "5.0.5",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAiConversation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAiConversation\\Tests\\": "tests/"
    }
  },
  "description": "Conversations with agents, on symfony-conversation: the agent taking part, agents and models as entities, Claude's transcripts, the tools an agent calls",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/uid": ">=6.2",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-ai": ">=6.1.0",
    "wexample/symfony-api": ">=19.0.0",
    "wexample/symfony-conversation": ">=6.0.0",
    "wexample/symfony-design-system": ">=48.0.0",
    "wexample/symfony-forms": ">=17.0.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-live": ">=5.8.0",
    "wexample/symfony-pseudocode": ">=4.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}